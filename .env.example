# GitHub credentials and repository configuration for local development.
# Copy this file to .env and fill in the private values there.
# Never commit the populated .env file.

# Fine-grained GitHub personal access token.
# Required repository access: the target repository.
# Required repository permission: Contents — Read and write.
GITHUB_TOKEN=

# GitHub repository in owner/repository format, for example:
# GITHUB_REPO=your-github-username/peptide-papi
GITHUB_REPO=

# Optional local Git identity values.
GITHUB_USERNAME=
GIT_USER_NAME=
GIT_USER_EMAIL=

# Public canonical URL. Replace with the production URL when deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
